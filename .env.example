# From @BotFather
BOT_TOKEN=
# Your Telegram user id (send /start to the bot once, or use @userinfobot). Comma-separated for several.
ALLOWED_CHAT_IDS=
# Optional: residential/mobile proxy if datacenter IPs get blocked, e.g. http://user:pass@host:port
PROXY_URL=
POLL_INTERVAL=180
DESC_CHECKS_PER_CYCLE=5
MAX_NEW_ALERTS=15
# Optional overrides (defaults: Yerevan long-term rent, <=220,000 AMD, without Avan/Nor Nork/Nork-Marash/Nubarashen)
# SEARCH_URL=
# EXCLUDE_LOCATIONS=Nor Nork,Nork-Marash,Nubarashen,Avan
# banali.am as a second source (1 = on, 0 = off) and how many 10-ad pages to read per cycle
# BANALI=1
# BANALI_PAGES=3
# list.am fetcher: "http" (default, ~170 MB RAM, fits 512 MB) or "browser" (Chromium under Xvfb, ~1-2 GB; build with Dockerfile.browser)
# LISTAM_FETCHER=http
